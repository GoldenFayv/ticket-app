model Ticket {
    id Int @id @default(autoincrement())
    name String
    description String?
    price Float
    quantity Int
    purchased_quantity Int
    event_id Int
    event Event @relation(fields: [event_id], references: [id])
    createAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([name, event_id])
}
